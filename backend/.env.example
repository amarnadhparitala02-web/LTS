PORT=4000
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.example
# Leads are appended to this file (use a persistent volume in production)
DATA_FILE=./data/leads.ndjson
# Required to read leads via GET /api/leads (Authorization: Bearer <token>). Use a long random value.
ADMIN_TOKEN=
# Max enquiries per IP per 15 minutes
RATE_LIMIT_MAX=5

# Email notification (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_TO=you@your-domain.example

# Optional: POST each lead as JSON (Slack/Zapier/Make/CRM)
WEBHOOK_URL=
