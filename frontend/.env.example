# Backend base URL. Leave empty in dev (Vite proxies /api to localhost:4000).
# In production set it to your API origin, e.g. https://api.your-domain.example
VITE_API_URL=

# Public site URL (used for canonical/OG tags are set in index.html; keep in sync)
VITE_SITE_URL=https://your-domain.example

# Contact details shown on the site. Anything left empty is simply not displayed.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# Digits only with country code, e.g. 919876543210
VITE_WHATSAPP=
VITE_LOCATION=
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
VITE_GITHUB_URL=
